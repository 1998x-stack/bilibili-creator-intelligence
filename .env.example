# SQLite and local artifacts; never commit your actual .env or cookies.
BCI_DB_PATH=./data/bilibili.sqlite3
BCI_ARTIFACTS_DIR=./data/artifacts
BCI_COOKIES_FILE=

# faster-whisper (local). Set language=zh for Mandarin-only recordings.
BCI_WHISPER_MODEL=small
BCI_WHISPER_DEVICE=auto
BCI_WHISPER_COMPUTE_TYPE=int8
BCI_WHISPER_LANGUAGE=

# OpenAI or a fully compatible Chat Completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=
BCI_LLM_MODEL=gpt-4o-mini
# schema (strict Pydantic JSON Schema), or explicit json compatibility mode
BCI_LLM_MODE=schema
BCI_LLM_MAX_INPUT_TOKENS=6000
BCI_LLM_MAX_OUTPUT_TOKENS=1500
# Deprecated v0.2 setting, kept for backwards compatibility only:
BCI_LLM_MAX_CHARS=12000

# Video workers and bounded process-local resources.
BCI_WORKERS=2
BCI_NETWORK_WORKERS=1
BCI_ASR_WORKERS=1
BCI_LLM_WORKERS=2
BCI_LLM_RPM=30
BCI_LLM_TPM=60000

# Optional estimated budget in USD. Fill BOTH actual prices from your provider,
# as USD per 1 million tokens, before enabling a budget. No prices are invented.
BCI_LLM_INPUT_USD_PER_MTOK=
BCI_LLM_OUTPUT_USD_PER_MTOK=
BCI_LLM_BUDGET_USD=
