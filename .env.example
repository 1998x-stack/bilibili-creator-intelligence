# Local SQLite database
BCI_DB_PATH=./data/bilibili.sqlite3
BCI_ARTIFACTS_DIR=./data/artifacts

# LLM: OpenAI or an OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
BCI_LLM_MODEL=gpt-4o-mini
BCI_LLM_MAX_CHARS=12000

# Local ASR (install: pip install -e '.[asr]')
BCI_WHISPER_MODEL=small
BCI_WHISPER_DEVICE=auto
BCI_WHISPER_COMPUTE_TYPE=int8

# Optional cookies for content you own or are explicitly authorized to process.
# Prefer a local Netscape cookies file; do not commit it.
BCI_COOKIES_FILE=
